<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the same NUnit tests Unity's Test Runner runs: dotnet test DotNet/Tests -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Shared/Tests/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/LanternLounge.Core.csproj" />
    <ProjectReference Include="../PebbleDrop/LanternLounge.PebbleDrop.csproj" />
    <ProjectReference Include="../Tidebound/LanternLounge.Tidebound.csproj" />
    <ProjectReference Include="../PrismRush/LanternLounge.PrismRush.csproj" />
    <ProjectReference Include="../TreehouseHoldem/LanternLounge.TreehouseHoldem.csproj" />
  </ItemGroup>

</Project>
